+-    Calibration uses learned planar court points. None of the 3D comparisons
+-    here is an independent ground-truth accuracy measurement.
+-    """
+-    if any(
+-        value is None
+-        for value in (
+-            scene.ball_uv,
+-            scene.ball_vis,
+-            scene.ball_3d,
+-            scene.human_kp_2d,
+-            scene.human_kp_vis,
+-            scene.player_kp_3d,
+-        )
+-    ):
+-        raise ValueError(
+-            "Full PLCS/BLCS/pose observations are required for quality evaluation"
+-        )
