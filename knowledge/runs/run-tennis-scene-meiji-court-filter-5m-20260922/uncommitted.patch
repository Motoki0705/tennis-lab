+-        "src.tennis_scene.scripts.generate_dataset "
+-        f"dataset_directory={dataset_fragment}"
+-    )
+-    LOGGER.info("=" * 60)
+-    return 0
+-
+-
+-if __name__ == "__main__":
+-    main()
