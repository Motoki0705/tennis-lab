+-        np.linalg.norm(np.diff(scene.player_position, axis=1), axis=-1) * scene.fps
+-    )
+-    speed_ball = np.linalg.norm(np.diff(scene.ball_3d, axis=0), axis=-1) * scene.fps
+-    report = {
