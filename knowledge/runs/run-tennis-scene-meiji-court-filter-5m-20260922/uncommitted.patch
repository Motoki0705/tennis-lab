+-def shared_repository_root(project: Path) -> Path:
+-    result = subprocess.run(
+-        ["git", "rev-parse", "--path-format=absolute", "--git-common-dir"],
+-        cwd=project,
+-        check=True,
+-        capture_output=True,
+-        text=True,
+-    )
+-    common = Path(result.stdout.strip())
