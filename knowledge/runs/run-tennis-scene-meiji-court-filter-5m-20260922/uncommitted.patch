+-    association_settings(settings)
+-    if settings.get("selection_policy") == "largest":
+-        del settings["selection_policy"]
+-    if "long_gap_policy" in settings and settings["long_gap_policy"] == "error":
+-        del settings["long_gap_policy"]
+-    return settings
