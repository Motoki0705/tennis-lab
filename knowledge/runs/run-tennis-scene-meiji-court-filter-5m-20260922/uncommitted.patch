+++        "saturated_below_zero_count": int(np.count_nonzero(peaks < 0)),
+++        "saturated_above_one_count": int(np.count_nonzero(peaks > 1)),
+++    }
+++    return np.clip(peaks, 0, 1).astype(np.float32), audit
