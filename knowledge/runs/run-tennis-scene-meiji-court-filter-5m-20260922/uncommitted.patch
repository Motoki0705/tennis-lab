+-        valid &= scene.ball_vis[view].astype(bool)
+-        errors[view, valid] = np.linalg.norm(
+-            pixels[valid] - scene.ball_uv[view, valid] * [scene.width, scene.height],
+-            axis=-1,
+-        )
+-    return errors
