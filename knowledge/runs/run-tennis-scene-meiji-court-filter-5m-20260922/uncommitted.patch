+-        "camera_ids": clip["camera_ids"],
+-        "sources": sources,
+-        "status": states,
+-        "score_semantics": "binary coordinate availability; not detector confidence",
+-        "included_statuses": [
+-            "observed",
+-            "interpolated",
+-            "occlusion_estimated",
+-        ],
+-    }
