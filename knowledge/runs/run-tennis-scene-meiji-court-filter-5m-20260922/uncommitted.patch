+-            data["source"]["width"],
+-            data["source"]["height"],
+-            data["source"]["frame_count"],
+-        ) != (clip["width"], clip["height"], t):
+-            raise ValueError(f"Ball source dimensions mismatch: {cam}")
+-        frames = data["frames"]
