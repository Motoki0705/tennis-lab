+-                [
+-                    np.median(points[valid, 1])
+-                    for points, valid in zip(court, valid_feet, strict=True)
+-                ]
+-            )
+-            order = np.argsort(median_y)
+-            if len(order) != 2 or not median_y[order[0]] < 0 < median_y[order[1]]:
