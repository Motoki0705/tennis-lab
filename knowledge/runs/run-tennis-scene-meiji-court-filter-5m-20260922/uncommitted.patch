+-    isolated_jump: float
+-    neighbor_distance: float
+-
+-    @classmethod
+-    def from_config(cls, cfg: DictConfig) -> BroadcastImportConfig:
+-        exact_config_mapping(
+-            cfg,
+-            path="broadcast_import",
+-            required_keys={
+-                "paths",
+-                "source",
+-                "destination",
+-                "dataset_id",
+-                "video_groups",
+-                "isolated_jump",
+-                "neighbor_distance",
