+    write_float32(path, np.ones((2, 3), dtype=np.float32))
+    with np.load(path) as archive:
+        payload = {key: archive[key] for key in archive.files}
+    payload["byte_planes"][0, 0] ^= 1
+    np.savez_compressed(path, **payload)
