+            self.visibility_before_false_positive: torch.Tensor | None = None
+
+        def forward(
+            self, sample: dict[str, torch.Tensor]
+        ) -> dict[str, torch.Tensor]:
+            self.visibility_before_false_positive = sample["ball_vis"].clone()
