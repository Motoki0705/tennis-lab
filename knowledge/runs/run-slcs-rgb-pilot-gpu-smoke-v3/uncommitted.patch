+  - override model: multiview_axial_small
+  - override data: multiview_sequence_broadcast
+  - _self_
+model:
+  max_num_cameras: 2
+  max_seq_len: 128
+data:
+  num_views_range: [1, 1]
+  seq_len_range: [128, 128]
