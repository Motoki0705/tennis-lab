+        return rally, xyz, cameras
+
+    name = f"rally_{index:06d}"
+    result, xyz, cameras = generate_with_bounded_physics_resampling(proposal, scene_id=name, maximum_attempts=generation.maximum_attempts)
+    points, visible = [], []
+    for view in cameras:
