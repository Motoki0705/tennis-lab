+
+
+@hydra_main(
+    config_path="../configs",
+    config_name="train_triangulation_residual",
+    version_base="1.3",
+    validation_boundary="blcs.triangulation_residual.train",
+)
+def main(config: DictConfig) -> None:
+    """Validate the BLCS contract and execute the shared training runner."""
