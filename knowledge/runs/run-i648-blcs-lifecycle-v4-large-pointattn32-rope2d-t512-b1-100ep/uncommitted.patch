+def test_court_annotation_permutation_keeps_player_outputs_identical() -> None:
+    torch.manual_seed(6)
+    model = _model()
+    inputs = {
+        "human_kp": torch.rand(1, 2, 3, 2, 17, 2),
+        "detection_mask": torch.ones(1, 2, 3, 2, dtype=torch.bool),
+        "court_kp": torch.rand(1, 2, 3, 14, 2),
+        "court_vis": torch.ones(1, 2, 3, 14, dtype=torch.bool),
+        "frame_mask": torch.ones(1, 3, dtype=torch.bool),
+        "view_mask": torch.ones(1, 2, dtype=torch.bool),
+    }
+    permutation = torch.tensor([8, 2, 13, 0, 6, 10, 1, 7, 4, 12, 3, 9, 5, 11])
+    permuted = {key: value.clone() for key, value in inputs.items()}
+    permuted["court_kp"] = inputs["court_kp"][..., permutation, :]
+    permuted["court_vis"] = inputs["court_vis"][..., permutation]
+
+    with torch.no_grad():
+        output = model(**inputs)
+        permuted_output = model(**permuted)
+
+    for key in output:
+        torch.testing.assert_close(output[key], permuted_output[key])
+
+
