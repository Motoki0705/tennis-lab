-"""Pixel <-> normalized keypoint conversions (numpy)."""
+"""Keypoint coordinate conversion and geometry-based ordering helpers."""
 
 from __future__ import annotations
 
 import numpy as np
+import torch
 from numpy.typing import NDArray
+from torch import Tensor
+
+
+def diagonal_sweep_permutation(keypoints: Tensor) -> Tensor:
+    """Return point indices swept from image top-left to bottom-right.
+
+    A line perpendicular to the ``(1, 1)`` image diagonal is moved from the
+    top-left toward the bottom-right. Points are therefore ordered by ``u+v``.
+    Points touched by the same sweep line are ordered left-to-right by ``u``.
+
+    Args:
+        keypoints: Tensor shaped ``(..., K, 2)`` in any consistent image
+            coordinate system.
+
+    Returns:
+        Long tensor shaped ``(..., K)`` containing the permutation indices.
+    """
+    if keypoints.ndim < 2 or keypoints.shape[-1] != 2:
+        raise ValueError(
+            "keypoints must have shape (..., K, 2), got "
+            f"{tuple(keypoints.shape)}."
+        )
+    if not keypoints.dtype.is_floating_point:
+        raise TypeError("keypoints must use a floating-point dtype.")
+
+    u = keypoints[..., 0]
+    diagonal = u + keypoints[..., 1]
+    left_to_right = torch.argsort(u, dim=-1, stable=True)
+    diagonal_in_left_to_right_order = torch.gather(
+        diagonal, -1, left_to_right
+    )
+    sweep_order = torch.argsort(
+        diagonal_in_left_to_right_order,
+        dim=-1,
+        stable=True,
+    )
+    return torch.gather(left_to_right, -1, sweep_order)
+
+
+def order_keypoints_diagonal_sweep(
+    keypoints: Tensor,
+    visibility: Tensor | None = None,
+) -> tuple[Tensor, Tensor | None]:
+    """Order keypoints and an optional aligned visibility tensor geometrically.
+
+    The returned tensors are new tensors; inputs are not modified. Visible
+    points are swept first. Invisible points are placed afterward in their
+    original order, so their masked coordinates cannot move visible features
+    between flattened input slots.
+    """
+    if visibility is not None and visibility.shape != keypoints.shape[:-1]:
+        raise ValueError(
+            "visibility must match keypoints without the coordinate axis, got "
+            f"{tuple(visibility.shape)} for {tuple(keypoints.shape)}."
+        )
+    ordering_keypoints = keypoints
+    if visibility is not None:
+        visible = visibility if visibility.dtype == torch.bool else visibility > 0
+        ordering_keypoints = keypoints.masked_fill(
+            ~visible.unsqueeze(-1), float("inf")
+        )
+    permutation = diagonal_sweep_permutation(ordering_keypoints)
+    ordered_keypoints = torch.gather(
+        keypoints,
+        -2,
+        permutation.unsqueeze(-1).expand(*permutation.shape, 2),
+    )
+    ordered_visibility = (
+        torch.gather(visibility, -1, permutation)
+        if visibility is not None
+        else None
+    )
+    return ordered_keypoints, ordered_visibility
 
 
 def clamp_pixel_coordinate(value: float, axis_size: int) -> float:
