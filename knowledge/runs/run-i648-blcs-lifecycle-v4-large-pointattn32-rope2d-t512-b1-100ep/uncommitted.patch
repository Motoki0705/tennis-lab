 from __future__ import annotations
 
 import numpy as np
+import pytest
+import torch
 
 from src.utils.geometry.keypoints import (
     clamp_pixel_coordinate,
     denormalize_keypoints,
+    diagonal_sweep_permutation,
     normalize_keypoints,
+    order_keypoints_diagonal_sweep,
 )
 
 
+def test_diagonal_sweep_orders_by_u_plus_v_then_left_to_right() -> None:
+    keypoints = torch.tensor(
+        [[0.8, 0.8], [0.6, 0.2], [0.1, 0.7], [0.2, 0.1]],
+        dtype=torch.float32,
+    )
+
+    permutation = diagonal_sweep_permutation(keypoints)
+
+    torch.testing.assert_close(permutation, torch.tensor([3, 2, 1, 0]))
+
+
+def test_diagonal_sweep_reorders_aligned_visibility_without_mutation() -> None:
+    keypoints = torch.tensor(
+        [[[[0.8, 0.8], [0.2, 0.1], [0.1, 0.7]]]], dtype=torch.float32
+    )
+    visibility = torch.tensor([[[False, True, False]]])
+    original = keypoints.clone()
+
+    ordered, ordered_visibility = order_keypoints_diagonal_sweep(
+        keypoints, visibility
+    )
+
+    torch.testing.assert_close(
+        ordered,
+        torch.tensor([[[[0.2, 0.1], [0.8, 0.8], [0.1, 0.7]]]]),
+    )
+    assert ordered_visibility is not None
+    torch.testing.assert_close(
+        ordered_visibility, torch.tensor([[[True, False, False]]])
+    )
+    torch.testing.assert_close(keypoints, original)
+
+
+def test_diagonal_sweep_rejects_non_floating_keypoints() -> None:
+    with pytest.raises(TypeError, match="floating-point"):
+        diagonal_sweep_permutation(torch.tensor([[0, 1], [1, 0]]))
+
+
