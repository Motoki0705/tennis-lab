+<script>
+const D=JSON.parse(document.getElementById('data').textContent),canvas=document.getElementById('scene'),ctx=canvas.getContext('2d');
+const slider=document.getElementById('time'),clock=document.getElementById('clock'),view=document.getElementById('view'),pairs=document.getElementById('pairs');
+let az=-0.6,el=0.9,zoom=1,drag=null,running=false,startTime=0,startFrame=0;
+const colors=['#35d9cf','#ffb45e']; const good=p=>p&&p.every(v=>v!==null&&Number.isFinite(v));
+function draw(){
+ const width=canvas.clientWidth,height=canvas.clientHeight,dpr=devicePixelRatio||1;canvas.width=width*dpr;canvas.height=height*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);
+ ctx.fillStyle='#101a2b';ctx.fillRect(0,0,width,height);let t=+slider.value,world=view.value==='world',person=world?-1:+view.value;
+ let origin=[0,0,0.4],scale=Math.min(width/45,height/43)*zoom;
+ if(!world){const hip=D.points[person][t].slice(11,13).filter(good);if(hip.length)origin=[hip.reduce((s,p)=>s+p[0],0)/hip.length,hip.reduce((s,p)=>s+p[1],0)/hip.length,1];scale=Math.min(width,height)/3.5*zoom;}
+ const project=p=>{let x=p[0]-origin[0],y=p[1]-origin[1],z=p[2]-origin[2];let u=x*Math.cos(az)-y*Math.sin(az),v=x*Math.sin(az)+y*Math.cos(az);return[width/2+u*scale,height/2+(v*Math.sin(el)-z*Math.cos(el))*scale];};
+ function line(a,b,color,w=1){if(!good(a)||!good(b))return;let p=project(a),q=project(b);ctx.strokeStyle=color;ctx.lineWidth=w;ctx.beginPath();ctx.moveTo(...p);ctx.lineTo(...q);ctx.stroke();}
+ if(world){for(const seg of D.court)line([...seg[0],0],[...seg[1],0],'#809a9d',1.4);line([-5.485,0,.914],[5.485,0,.914],'#bcccd5',2);D.centers.forEach((p,c)=>{const q=project(p);ctx.fillStyle='#94a9c6';ctx.fillRect(q[0]-4,q[1]-4,8,8);ctx.font='13px system-ui';ctx.fillText('cam'+c,q[0]+8,q[1]);});}
+ else{for(let i=-2;i<=2;i++){line([origin[0]+i*.5,origin[1]-1.5,0],[origin[0]+i*.5,origin[1]+1.5,0],'#30444c');line([origin[0]-1.5,origin[1]+i*.5,0],[origin[0]+1.5,origin[1]+i*.5,0],'#30444c');}}
+ function skeleton(points,color,w){for(const [a,b]of D.edges)line(points[a],points[b],color,w);for(const p of points){if(!good(p))continue;const q=project(p);ctx.fillStyle=color;ctx.beginPath();ctx.arc(q[0],q[1],world?2.4:4,0,2*Math.PI);ctx.fill();}}
+ for(let i=0;i<2;i++){if(!world&&i!==person)continue;if(pairs.checked)for(let k=0;k<3;k++)skeleton(D.pairs[k][i][t],['#8f9bad99','#bdcadb77','#e3ecf455'][k],1.5);skeleton(D.points[i][t],colors[i],world?2.7:4);}
+ ctx.font='14px system-ui';ctx.fillStyle='#bccbdc';ctx.fillText(world?'コート座標 / 単位 m':'XYのみ中心化 / Z=0はコート地面',20,28);clock.textContent=`frame ${t} / 1009 · ${(t/D.fps).toFixed(2)} s`;
+}
+canvas.onpointerdown=e=>{drag=[e.clientX,e.clientY];canvas.setPointerCapture(e.pointerId);};canvas.onpointermove=e=>{if(!drag)return;az+=(e.clientX-drag[0])*.006;el=Math.max(-.2,Math.min(1.55,el+(e.clientY-drag[1])*.006));drag=[e.clientX,e.clientY];draw();};canvas.onpointerup=()=>drag=null;
+canvas.onwheel=e=>{e.preventDefault();zoom=Math.max(.4,Math.min(5,zoom*Math.exp(-e.deltaY*.001)));draw();};
+slider.oninput=()=>{startFrame=+slider.value;startTime=performance.now();draw();};view.onchange=()=>{az=-.6;el=view.value==='world'?.9:.15;zoom=1;draw();};pairs.onchange=draw;
+document.getElementById('reset').onclick=()=>{az=-.6;el=view.value==='world'?.9:.15;zoom=1;draw();};
+document.getElementById('play').onclick=()=>{running=!running;startFrame=+slider.value;startTime=performance.now();document.getElementById('play').textContent=running?'停止':'再生';};
+function tick(now){if(running){slider.value=(startFrame+Math.floor((now-startTime)/1000*D.fps))%D.frames;draw();}requestAnimationFrame(tick);}requestAnimationFrame(tick);window.onresize=draw;draw();
+</script></html>
