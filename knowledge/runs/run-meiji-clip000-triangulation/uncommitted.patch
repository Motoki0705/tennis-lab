index 00000000..21535dfc
--- /dev/null
+++ b/src/utils/geometry/triangulation.py
@@ -0,0 +1,134 @@
+"""CPU multi-view triangulation in the coordinate system of supplied cameras.
+
+Cameras are fixed OpenCV pinhole matrices ``P = K [R | t]`` with positive
+camera-Z in front. Observations must be undistorted pixel coordinates. This
+module does not estimate calibration, associate people, or smooth time.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+from numpy.typing import NDArray
+
+FloatArray = NDArray[np.float64]
+
+
+@dataclass(frozen=True)
+class TriangulationResult:
+    """Invalid 3D points/reprojections are NaN; ``used_views`` records input use."""
+
+    points: FloatArray
+    valid: NDArray[np.bool_]
+    used_views: NDArray[np.bool_]
+    reprojected: FloatArray
+    depths: FloatArray
+
+
+def project_multiview(
+    points: FloatArray, cameras: FloatArray
+) -> tuple[FloatArray, FloatArray]:
+    """Project ``(..., 3)`` points through ``(V, 3, 4)`` matrices, in pixels."""
+    homogeneous = np.concatenate((points, np.ones((*points.shape[:-1], 1))), axis=-1)
+    image = np.einsum("vij,...j->...vi", cameras, homogeneous)
+    depth = image[..., 2]
+    with np.errstate(divide="ignore", invalid="ignore"):
+        uv = image[..., :2] / depth[..., None]
+    uv = np.where((np.abs(depth) > 1e-12)[..., None], uv, np.nan)
+    return uv, depth
+
+
+def triangulate_multiview(
+    observations: FloatArray,
+    scores: FloatArray,
+    cameras: FloatArray,
+    *,
+    min_score: float = 0.3,
+    refinement_steps: int = 12,
+) -> TriangulationResult:
+    """Weighted DLT followed by weighted pixel reprojection minimization.
+
+    ``observations``: (..., V, 2); ``scores``: (..., V). At least two finite
+    observations with score >= min_score and score > 0 are required. Weights
+    are clipped detector scores, not calibrated uncertainty probabilities.
+    Missing views, degenerate DLT and negative depth in any used view produce
+    explicit invalid points. No outlier rejection or anatomical prior is used.
+    """
+    uv = np.asarray(observations, dtype=np.float64)
+    score = np.asarray(scores, dtype=np.float64)
+    p = np.asarray(cameras, dtype=np.float64)
+    if p.ndim != 3 or p.shape[1:] != (3, 4) or len(p) < 2:
+        raise ValueError("cameras must have shape (V>=2, 3, 4)")
+    if uv.shape[-2:] != (len(p), 2) or score.shape != uv.shape[:-1]:
+        raise ValueError(
+            "observations/scores must have matching (..., V, 2)/(..., V) shapes"
+        )
+    if (
+        not np.isfinite(p).all()
+        or not np.isfinite(min_score)
+        or min_score < 0
+        or refinement_steps < 0
+    ):
+        raise ValueError("invalid camera, threshold, or refinement_steps")
+    leading = uv.shape[:-2]
+    uv = uv.reshape(-1, len(p), 2)
+    score = score.reshape(-1, len(p))
+    used = (
+        np.isfinite(uv).all(-1)
+        & np.isfinite(score)
+        & (score >= min_score)
+        & (score > 0)
+    )
+    weight = np.where(used, np.clip(score, 0, 1), 0)
+    uv = np.where(used[..., None], uv, 0)
+    a = uv[..., None] * p[None, :, 2:3, :] - p[None, :, :2, :]
+    a = (a * np.sqrt(weight)[..., None, None]).reshape(-1, 2 * len(p), 4)
+    _, singular, vh = np.linalg.svd(a, full_matrices=False)
+    h = vh[:, -1]
+    valid = (used.sum(-1) >= 2) & (np.abs(h[:, 3]) > 1e-10)
+    valid &= singular[:, -2] > np.maximum(singular[:, 0] * 1e-10, 1e-12)
+    x = np.full((len(uv), 3), np.nan)
+    x[valid] = h[valid, :3] / h[valid, 3:4]
+
+    indices = np.flatnonzero(valid)
+    if len(indices) and refinement_steps:
+        y = x[indices].copy()
+        target = uv[indices]
+        w = weight[indices]
+        for _ in range(refinement_steps):
+            pred, depth = project_multiview(y, p)
+            # A missing camera may have zero depth: 0 * NaN is still NaN.
+            pred = np.where(w[..., None] > 0, pred, 0)
+            safe_depth = np.where(np.abs(depth) > 1e-8, depth, 1e-8)
+            jac = p[None, :, :2, :3] - pred[..., None] * p[None, :, 2:3, :3]
+            jac /= safe_depth[..., None, None]
+            residual = pred - target
+            normal = np.einsum("nvai,nvaj,nv->nij", jac, jac, w)
+            gradient = np.einsum("nvai,nva,nv->ni", jac, residual, w)
+            damping = np.maximum(np.trace(normal, axis1=-2, axis2=-1), 1) * 1e-8
+            normal += damping[:, None, None] * np.eye(3)
+            step = np.linalg.solve(normal, gradient[..., None])[..., 0]
+            cost = np.sum(residual**2 * w[..., None], axis=(1, 2))
+            accepted = np.zeros(len(y), dtype=bool)
+            for scale in (1.0, 0.5, 0.25, 0.125):
+                candidate = y - scale * step
+                trial, _ = project_multiview(candidate, p)
+                trial = np.where(w[..., None] > 0, trial, 0)
+                trial_cost = np.sum((trial - target) ** 2 * w[..., None], axis=(1, 2))
+                take = (~accepted) & np.isfinite(trial_cost) & (trial_cost <= cost)
+                y[take] = candidate[take]
+                accepted |= take
+        x[indices] = y
+    projected, depths = project_multiview(x, p)
+    valid &= np.isfinite(x).all(-1) & ((depths > 1e-6) | ~used).all(-1)
+    x[~valid] = np.nan
+    projected[~valid] = np.nan
+    depths[~valid] = np.nan
+    return TriangulationResult(
+        points=x.reshape(*leading, 3),
+        valid=valid.reshape(leading),
+        used_views=used.reshape(*leading, len(p)),
+        reprojected=projected.reshape(*leading, len(p), 2),
+        depths=depths.reshape(*leading, len(p)),
+    )
diff --git a/tests/unit/utils/geometry/test_triangulation.py b/tests/unit/utils/geometry/test_triangulation.py
new file mode 100644
index 00000000..17079e82
--- /dev/null
+++ b/tests/unit/utils/geometry/test_triangulation.py
@@ -0,0 +1,82 @@
+"""Synthetic ground-truth checks for the geometric initializer."""
+
+import numpy as np
+from numpy.testing import assert_allclose
+
+from src.utils.geometry.triangulation import project_multiview, triangulate_multiview
+
+
+def fixture_scene():
+    k = np.array([[1000.0, 0.0, 960.0], [0.0, 1000.0, 540.0], [0.0, 0.0, 1.0]])
+    p = np.stack(
+        [
+            k @ np.column_stack((np.eye(3), -np.array(c)))
+            for c in [(-2.0, 0.0, 0.0), (2.0, 0.0, 0.0), (0.0, 2.0, 0.0)]
+        ]
+    )
+    x = np.random.default_rng(19).uniform(
+        [-1.0, -1.0, 4.0], [1.0, 1.0, 8.0], (2, 17, 3)
+    )
+    uv, _ = project_multiview(x, p)
+    return x, uv, p
+
+
+def test_recovers_world_coordinates_with_missing_and_corrupt_view():
+    x, uv, p = fixture_scene()
+    score = np.ones(uv.shape[:-1])
+    uv[0, 0, 0] = np.nan
+    uv[0, 1, 1] += 200
+    score[0, 1, 1] = 0.01
+    result = triangulate_multiview(uv, score, p)
+    assert result.valid.all()
+    assert_allclose(result.points, x, atol=1e-8)
+    assert not result.used_views[0, 0, 0]
+    assert not result.used_views[0, 1, 1]
+
+
+def test_refinement_reduces_weighted_pixel_error():
+    _, uv, p = fixture_scene()
+    uv += np.random.default_rng(31).normal(0, 5, uv.shape)
+    score = np.random.default_rng(12).uniform(0.4, 1, uv.shape[:-1])
+    initial = triangulate_multiview(uv, score, p, refinement_steps=0)
+    refined = triangulate_multiview(uv, score, p)
+    before = np.sum((initial.reprojected - uv) ** 2 * score[..., None], axis=(-1, -2))
+    after = np.sum((refined.reprojected - uv) ** 2 * score[..., None], axis=(-1, -2))
+    assert np.all(after <= before + 1e-7)
+    assert np.any(after < before - 1e-5)
+
+
+def test_rejects_missing_degenerate_and_behind_camera():
+    x, uv, p = fixture_scene()
+    score = np.ones(uv.shape[:-1])
+    score[0, 0, :2] = 0
+    result = triangulate_multiview(uv, score, p)
+    assert not result.valid[0, 0]
+    assert np.isnan(result.points[0, 0]).all()
+    repeated = np.repeat(p[:1], 3, axis=0)
+    repeated_uv, _ = project_multiview(x, repeated)
+    assert not triangulate_multiview(
+        repeated_uv, np.ones_like(score), repeated
+    ).valid.any()
+    x[..., 2] *= -1
+    behind, _ = project_multiview(x, p)
+    assert not triangulate_multiview(behind, np.ones_like(score), p).valid.any()
+
+
+def test_missing_camera_on_projection_plane_does_not_poison_visible_pair():
+    x = np.array([[0.0, 0.0, 6.0]])
+    p = np.stack(
+        [
+            np.column_stack((np.eye(3), t))
+            for t in [
+                np.array([2.0, 0.0, 0.0]),
+                np.array([-2.0, 0.0, 0.0]),
+                np.array([0.0, -2.0, -6.0]),
+            ]
+        ]
+    )
+    uv, _ = project_multiview(x, p)
+    score = np.array([[1.0, 1.0, 0.0]])
+    result = triangulate_multiview(uv, score, p)
+    assert result.valid.all()
+    assert_allclose(result.points, x, atol=1e-8)
diff --git a/scripts/analysis/triangulation/evaluate.py b/scripts/analysis/triangulation/evaluate.py
new file mode 100644
index 00000000..03866bef
--- /dev/null
+++ b/scripts/analysis/triangulation/evaluate.py
@@ -0,0 +1,287 @@
+"""Evaluate a saved, associated SceneResult without model inference or GPU use."""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+from itertools import combinations
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+
+from src.utils.geometry.triangulation import project_multiview, triangulate_multiview
+from src.utils.schema.court import STANDARD_COURT_CONFIG, court_keypoints_3d
+from src.utils.schema.player import COCO17_BONE_LENGTH_EDGES, COCO_KP_NAMES
+
+
+def stats(values: np.ndarray) -> dict[str, float | int | None]:
+    values = np.asarray(values)
+    values = values[np.isfinite(values)]
+    if not len(values):
+        return {"n": 0, "mean": None, "median": None, "p95": None}
+    return {
+        "n": len(values),
+        "mean": float(values.mean()),
+        "median": float(np.median(values)),
+        "p05": float(np.quantile(values, 0.05)),
+        "p95": float(np.quantile(values, 0.95)),
+        "max": float(values.max()),
+    }
+
+
+def sha256(path: Path) -> str:
+    result = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            result.update(block)
+    return result.hexdigest()
+
+
+def evaluate(clip: Path, output: Path, min_score: float) -> dict[str, Any]:
+    scene_path = clip / "annotations/tennis_scene/scene.npz"
+    metadata_path = scene_path.with_suffix(".metadata.json")
+    metadata = json.loads(metadata_path.read_text())
+    manifest = json.loads((clip / "clip.json").read_text())
+    reference = metadata["court_reference"]
+    cameras = reference["camera_fits"]
+    ids = metadata["camera_ids"]
+    assert ids == manifest["camera_ids"] == reference["camera_ids"]
+    assert len(cameras) == 3, "This diagnostic reports three-view leave-one-camera-out."
+    association = json.loads(
+        (clip / "annotations/player_association_result.json").read_text()
+    )
+    assert metadata["player_association"] == association
+    p = np.array(
+        [np.array(c["K"]) @ np.column_stack((c["R"], c["t"])) for c in cameras]
+    )
+    centers = np.array([c["camera_center_court_m"] for c in cameras])
+    for c in cameras:
+        r, t = np.array(c["R"]), np.array(c["t"])
+        np.testing.assert_allclose(r.T @ r, np.eye(3), atol=1e-7)
+        np.testing.assert_allclose(-r.T @ t, c["camera_center_court_m"], atol=1e-7)
+    with np.load(scene_path, allow_pickle=False) as z:
+        width, height, fps = int(z["width"]), int(z["height"]), float(z["fps"])
+        uv = z["human_kp_2d"].transpose(0, 2, 3, 1, 4).astype(float) * [width, height]
+        scores = z["human_kp_vis"].transpose(0, 2, 3, 1).astype(float)
+        court = z["court_kp"][:, 0].astype(float) * [width, height]
+        assert int(z["num_frames"]) == manifest["num_frames"] == uv.shape[1]
+    result = triangulate_multiview(uv, scores, p, min_score=min_score)
+    residual = uv - result.reprojected
+    errors = np.linalg.norm(residual, axis=-1)
+    observed = result.used_views & result.valid[..., None]
+    errors_masked = np.where(observed, errors, np.nan)
+    physical_court = court_keypoints_3d(STANDARD_COURT_CONFIG).numpy().astype(float)
+    manual = json.loads((clip / "annotations/manual_court_kp_result.json").read_text())
+    court_fits = []
+    for v, camera in enumerate(cameras):
+        mapping = reference["court_keypoint_views"][v]["semantic_to_physical"][:14]
+        # SceneResult stores reference/physical order; raw manual JSON is view order.
+        raw_court = np.array(manual["keypoints"][v][0]) * [width, height]
+        np.testing.assert_allclose(court[v], raw_court[mapping], atol=1e-4)
+        projected, _ = project_multiview(physical_court[:14], p[v : v + 1])
+        delta = projected[:, 0] - court[v]
+        court_fits.append(
+            {
+                "camera": ids[v],
+                "stored_coordinate_rmse_px": camera["rmse_px"],
+                "recomputed_coordinate_rmse_px": float(np.sqrt(np.mean(delta**2))),
+                "euclidean_error_px": stats(np.linalg.norm(delta, axis=-1)),
+                "center_court_m": camera["camera_center_court_m"],
+                "focal_px": camera["K"][0][0],
+            }
+        )
+        np.testing.assert_allclose(
+            np.sqrt(np.mean(delta**2)), camera["rmse_px"], atol=1e-4
+        )
+    metrics: dict[str, Any] = {
+        "clip": str(clip),
+        "frames": uv.shape[1],
+        "players": uv.shape[0],
+        "fps": fps,
+        "width": width,
+        "height": height,
+        "camera_ids": ids,
+        "independent_3d_ground_truth": False,
+        "method": "score-weighted DLT + 12 Gauss-Newton steps minimizing weighted pixel SSE",
+        "min_score": min_score,
+        "score_weight": "clip(score,0,1), not calibrated probabilities",
+        "temporal_smoothing": False,
+        "anatomical_prior": False,
+        "calibration": "saved CourtKP14-only pinhole, fixed centered principal point, fx=fy, zero distortion",
+        "coordinate_frame": "physical court, metres, XY ground, Z up",
+        "association": association,
+        "calibration_fits": court_fits,
+        "joint_coverage_percent": float(100 * result.valid.mean()),
+        "reprojection_px": stats(errors_masked),
+        "per_camera_reprojection_px": {
+            name: stats(errors_masked[..., i]) for i, name in enumerate(ids)
+        },
+        "per_joint_reprojection_px": {
+            name: stats(errors_masked[:, :, j]) for j, name in enumerate(COCO_KP_NAMES)
+        },
+        "players_detail": [],
+        "leave_one_camera_out": {},
+        "source_sha256": {
+            str(path.relative_to(clip)): sha256(path)
+            for path in [
+                scene_path,
+                metadata_path,
+                clip / "clip.json",
+                clip / "annotations/manual_court_kp_result.json",
+                clip / "annotations/player_association_result.json",
+            ]
+        },
+    }
+    bones = np.array(COCO17_BONE_LENGTH_EDGES)
+    lengths = np.linalg.norm(
+        result.points[..., bones[:, 0], :] - result.points[..., bones[:, 1], :], axis=-1
+    )
+    extreme = np.argwhere(lengths[:, :, 4:] > 1.0)
+    worst = np.unravel_index(np.nanargmax(lengths), lengths.shape)
+    wp, wt, wb = (int(i) for i in worst)
+    metrics["limb_length_diagnostics"] = {
+        "limb_instances_over_1m": len(extreme),
+        "person_frames_with_limb_over_1m": len(np.unique(extreme[:, :2], axis=0)),
+        "worst": {
+            "player": wp,
+            "frame": wt,
+            "edge": [COCO_KP_NAMES[j] for j in bones[wb]],
+            "length_m": float(lengths[worst]),
+            "joint_scores": scores[wp, wt, bones[wb]].tolist(),
+            "joint_used_views": result.used_views[wp, wt, bones[wb]].tolist(),
+        },
+    }
+    for person in range(uv.shape[0]):
+        median_lengths = np.nanmedian(lengths[person], axis=0)
+        hip = result.points[person][:, [11, 12], :].mean(axis=1)
+        metrics["players_detail"].append(
+            {
+                "player": person,
+                "coverage_percent": float(100 * result.valid[person].mean()),
+                "complete_17_joint_frames_percent": float(
+                    100 * result.valid[person].all(-1).mean()
+                ),
+                "per_joint_coverage_percent": {
+                    n: float(result.valid[person, :, j].mean() * 100)
+                    for j, n in enumerate(COCO_KP_NAMES)
+                },
+                "reprojection_px": stats(errors_masked[person]),
+                "limb_bone_absolute_deviation_from_own_temporal_median_m": stats(
+                    np.abs(lengths[person, :, 4:] - median_lengths[4:])
+                ),
+                "bones": {
+                    f"{COCO_KP_NAMES[a]}-{COCO_KP_NAMES[b]}": {
+                        "length_m": stats(lengths[person, :, i]),
+                        "temporal_std_m": float(np.nanstd(lengths[person, :, i])),
+                    }
+                    for i, (a, b) in enumerate(bones)
+                },
+                "ankle_height_m": stats(result.points[person, :, 15:17, 2]),
+                "ankle_below_minus_10cm_percent": float(
+                    np.mean(result.points[person, :, 15:17, 2] < -0.1) * 100
+                ),
+                "hip_height_m": stats(hip[:, 2]),
+            }
+        )
+    pair_points = []
+    for dropped in range(3):
+        keep = [v for v in range(3) if v != dropped]
+        pair = triangulate_multiview(
+            uv[..., keep, :], scores[..., keep], p[keep], min_score=min_score
+        )
+        predicted, depth = project_multiview(pair.points, p)
+        eval_mask = (
+            pair.valid & (scores[..., dropped] >= min_score) & (depth[..., dropped] > 0)
+        )
+        heldout_error = np.linalg.norm(
+            predicted[..., dropped, :] - uv[..., dropped, :], axis=-1
+        )
+        displacement = np.linalg.norm(pair.points - result.points, axis=-1)
+        metrics["leave_one_camera_out"][ids[dropped]] = {
+            "triangulation_cameras": [ids[k] for k in keep],
+            "coverage_percent": float(100 * pair.valid.mean()),
+            "heldout_reprojection_px": stats(heldout_error[eval_mask]),
+            "difference_to_three_view_m_not_ground_truth_error": stats(displacement),
+        }
+        pair_points.append(pair.points)
+    pair_points_array = np.stack(pair_points)
+    pair_disagreements = np.stack(
+        [
+            np.linalg.norm(pair_points_array[a] - pair_points_array[b], axis=-1)
+            for a, b in combinations(range(3), 2)
+        ]
+    )
+    metrics["pair_solution_disagreement_m_not_ground_truth_error"] = stats(
+        pair_disagreements
+    )
+    rays = result.points[..., None, :] - centers
+    rays /= np.linalg.norm(rays, axis=-1, keepdims=True)
+    angles = []
+    for a, b in combinations(range(3), 2):
+        # Acute line angle: antiparallel rays are also ill-conditioned.
+        angle = np.rad2deg(
+            np.arccos(
+                np.clip(
+                    np.abs(np.sum(rays[..., a, :] * rays[..., b, :], axis=-1)), 0, 1
+                )
+            )
+        )
+        angles.append(
+            np.where(
+                result.used_views[..., a] & result.used_views[..., b], angle, np.nan
+            )
+        )
+    with np.errstate(invalid="ignore"):
+        max_angle = np.max(np.where(np.isfinite(angles), angles, -np.inf), axis=0)
+    max_angle[~result.valid] = np.nan
+    metrics["best_available_ray_angle_deg"] = stats(max_angle)
+    output.mkdir(parents=True, exist_ok=True)
+    np.savez_compressed(
+        output / "triangulation.npz",
+        X_init=result.points,
+        valid=result.valid,
+        observations_px=uv,
+        scores=scores,
+        used_views=result.used_views,
+        projections=p,
+        camera_centers=centers,
+        reprojected_px=result.reprojected,
+        reprojection_residual_px=residual,
+        pair_points=pair_points_array,
+        bone_lengths_m=lengths,
+        fps=fps,
+        max_ray_angle_deg=max_angle,
+    )
+    (output / "metrics.json").write_text(
+        json.dumps(metrics, ensure_ascii=False, indent=2, allow_nan=False)
+    )
+    print(
+        json.dumps(
+            {
+                k: metrics[k]
+                for k in [
+                    "joint_coverage_percent",
+                    "reprojection_px",
+                    "leave_one_camera_out",
+                    "pair_solution_disagreement_m_not_ground_truth_error",
+                ]
+            },
+            indent=2,
+        )
+    )
+    return metrics
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--clip", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--min-score", type=float, default=0.3)
+    args = parser.parse_args()
+    evaluate(args.clip.resolve(), args.output.resolve(), args.min_score)
+
+
+if __name__ == "__main__":
+    main()
