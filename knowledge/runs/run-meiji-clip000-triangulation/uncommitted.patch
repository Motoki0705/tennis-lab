+"""Video, figures and an offline interactive viewer for triangulation diagnostics."""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+from typing import Any
+
+import cv2
+import matplotlib
+
+matplotlib.use("Agg")
+import matplotlib.pyplot as plt
+import numpy as np
+from matplotlib.backends.backend_agg import FigureCanvasAgg
+from mpl_toolkits.mplot3d.art3d import Line3DCollection, Poly3DCollection
+
+from src.utils.rendering.court_renderer import CourtLines, CourtRenderer, CourtStyle
+from src.utils.rendering.layers import SceneLayer, enable_explicit_layering
+from src.utils.schema.player import (
+    COCO17_SKELETON,
+)
+from src.utils.video.writer import VideoWriter
+
+BG = "#101a2b"
+COLORS = ("#35d9cf", "#ffb45e")
+BGR = ((207, 217, 53), (94, 180, 255))
+EDGES = np.array(COCO17_SKELETON)
+
+
+def cv_text(
+    img: np.ndarray,
+    text: str,
+    xy: tuple[int, int],
+    scale: float = 0.7,
+    color: tuple[int, int, int] = (235, 239, 245),
+) -> None:
+    cv2.putText(img, text, xy, cv2.FONT_HERSHEY_SIMPLEX, scale, color, 2, cv2.LINE_AA)
+
+
+def overlay(
+    image: np.ndarray,
+    obs: np.ndarray,
+    reproj: np.ndarray,
+    scores: np.ndarray,
+    color: tuple[int, int, int],
+    threshold: float,
+    scale: float = 1,
+) -> np.ndarray:
+    out = image.copy()
+    observed = (scores >= threshold) & np.isfinite(obs).all(-1)
+    predicted = np.isfinite(reproj).all(-1)
+    a = np.rint(np.nan_to_num(obs) * scale).astype(int)
+    b = np.rint(np.nan_to_num(reproj) * scale).astype(int)
+    for i, j in EDGES:
+        if predicted[i] and predicted[j]:
+            cv2.line(out, tuple(b[i]), tuple(b[j]), color, 2, cv2.LINE_AA)
+    for j in range(17):
+        if observed[j] and predicted[j]:
+            cv2.line(out, tuple(a[j]), tuple(b[j]), (190, 80, 255), 1, cv2.LINE_AA)
+        if observed[j]:
+            cv2.circle(out, tuple(a[j]), 3, (255, 255, 255), 1, cv2.LINE_AA)
+        if predicted[j]:
+            cv2.circle(out, tuple(b[j]), 2, color, -1, cv2.LINE_AA)
+    return out
+
+
+class PoseFigure:
+    def __init__(self, centers: np.ndarray) -> None:
+        self.fig = plt.figure(figsize=(19.2, 5.6), dpi=100, facecolor=BG)
+        self.axes: list[Any] = [
+            self.fig.add_axes(pos, projection="3d")
+            for pos in [
+                (0.00, 0.03, 0.48, 0.94),
+                (0.48, 0.04, 0.26, 0.91),
+                (0.74, 0.04, 0.26, 0.91),
+            ]
+        ]
+        for ax in self.axes:
+            enable_explicit_layering(ax)
+            ax.set_facecolor(BG)
+            for axis in (ax.xaxis, ax.yaxis, ax.zaxis):
+                axis.set_pane_color((0.06, 0.10, 0.16, 1))
+                axis._axinfo["grid"]["color"] = (0.3, 0.38, 0.47, 0.25)
+                axis.label.set_color("#a8b9cc")
+            ax.tick_params(colors="#9dacbd", labelsize=8)
+        world = self.axes[0]
+        CourtRenderer(
+            CourtStyle(
+                court_color="#183f43",
+                apron_color="#183039",
+                line_color="#9cb7ba",
+                line_width=0.8,
+            )
+        ).render_3d(
+            world, show_net=True, set_limits=False, apron_bounds=(-10, 10, -20, 20)
+        )
+        world.set(
+            xlim=(-10, 10),
+            ylim=(-20, 20),
+            zlim=(-0.15, 4),
+            xlabel="X [m]",
+            ylabel="Y [m]",
+            zlabel="Z [m]",
+        )
+        world.set_box_aspect((20, 40, 6))
+        world.view_init(elev=53, azim=-42)
+        world.set_title(
+            "COURT FRAME  |  3 cameras, no temporal smoothing",
+            color="white",
+            fontsize=13,
+            y=1.00,
+        )
+        world.scatter(*centers.T, c="#879bb5", s=28, marker="^")
+        for c, point in enumerate(centers):
+            world.text(*point, f" cam{c}", color="#b8c6d7", fontsize=9)
+        for person, ax in enumerate(self.axes[1:]):
+            ax.set(
+                xlim=(-1.25, 1.25),
+                ylim=(-1.25, 1.25),
+                zlim=(-0.2, 2.3),
+                xlabel="relative X [m]",
+                ylabel="relative Y [m]",
+                zlabel="court Z [m]",
+            )
+            ax.set_box_aspect((2.5, 2.5, 2.5))
+            ax.view_init(elev=12, azim=-65)
+            ax.add_collection3d(
+                Poly3DCollection(
+                    [
+                        [
+                            [-1.25, -1.25, 0],
+                            [1.25, -1.25, 0],
+                            [1.25, 1.25, 0],
+                            [-1.25, 1.25, 0],
+                        ]
+                    ],
+                    facecolor="#183f43",
+                    alpha=0.6,
+                    zorder=SceneLayer.SURFACE,
+                )
+            )
+            ax.set_title(
+                f"P{person}  |  XY centered, actual height",
+                color=COLORS[person],
+                fontsize=12,
+            )
+        self.bones, self.dots, self.trails = [], [], []
+        for person in range(2):
+            bone_pair, dot_pair = [], []
+            for ax in [world, self.axes[person + 1]]:
+                bone = Line3DCollection(
+                    [], colors=COLORS[person], linewidths=2.8, zorder=SceneLayer.PLAYER
+                )
+                ax.add_collection3d(bone, autolim=False)
+                dot = ax.scatter(
+                    [],
+                    [],
+                    [],
+                    c=COLORS[person],
+                    s=13,
+                    depthshade=False,
+                    zorder=SceneLayer.MARKER,
+                )
+                bone_pair.append(bone)
+                dot_pair.append(dot)
+            self.bones.append(bone_pair)
+            self.dots.append(dot_pair)
+            (trail,) = world.plot(
+                [], [], [], color=COLORS[person], alpha=0.45, linewidth=1
+            )
+            self.trails.append(trail)
+
+    def render(self, points: np.ndarray, t: int) -> np.ndarray:
+        for person in range(2):
+            raw = points[person, t]
+            center = np.nanmean(raw[[11, 12]], axis=0)
+            local = raw.copy()
+            local[:, :2] -= center[:2]
+            for j, pose in enumerate((raw, local)):
+                segments = pose[EDGES]
+                self.bones[person][j].set_segments(
+                    segments[np.isfinite(segments).all(axis=(1, 2))]
+                )
+                good = pose[np.isfinite(pose).all(-1)]
+                self.dots[person][j]._offsets3d = good.T
+            hips = np.nanmean(points[person, max(0, t - 100) : t + 1, 11:13], axis=1)
+            self.trails[person].set_data_3d(hips[:, 0], hips[:, 1], np.zeros(len(hips)))
+        self.fig.canvas.draw()
+        assert isinstance(self.fig.canvas, FigureCanvasAgg)
+        return np.asarray(self.fig.canvas.buffer_rgba())[..., :3].copy()
+
+
+def diagnostic_plot(data: dict[str, np.ndarray], metrics: dict, output: Path) -> None:
+    err = np.linalg.norm(data["reprojection_residual_px"], axis=-1)
+    err = np.where(data["used_views"] & data["valid"][..., None], err, np.nan)
+    plt.rcParams.update({"font.size": 10})
+    fig, axes = plt.subplots(2, 2, figsize=(15, 9), constrained_layout=True)
+    for c, color in enumerate(["#119d92", "#cf8731", "#4f68ba"]):
+        values = np.sort(err[..., c][np.isfinite(err[..., c])])
+        axes[0, 0].plot(
+            values,
+            np.arange(1, len(values) + 1) / len(values),
+            color=color,
+            label=f"cam{c}",
+        )
+    axes[0, 0].set(
+        xlim=(0, 25),
+        ylim=(0, 1),
+        xlabel="Euclidean reprojection error [px]",
+        ylabel="Fraction",
+        title="3-view fit: agreement with the same observations",
+    )
+    axes[0, 0].legend()
+    time = np.arange(data["X_init"].shape[1]) / metrics["fps"]
+    for player, color in enumerate(COLORS):
+        values = np.nanmean(err[player], axis=(1, 2))
+        axes[0, 1].plot(time, values, label=f"P{player}", color=color)
+    axes[0, 1].set(
+        xlabel="Time [s]",
+        ylabel="Mean reprojection error [px]",
+        title="All 1,010 frames, raw initializer",
+    )
+    axes[0, 1].legend()
+    entries = list(metrics["leave_one_camera_out"].values())
+    axes[1, 0].bar(
+        np.arange(3) - 0.18,
+        [a["heldout_reprojection_px"]["median"] for a in entries],
+        0.36,
+        label="Median",
+    )
+    axes[1, 0].bar(
+        np.arange(3) + 0.18,
+        [a["heldout_reprojection_px"]["p95"] for a in entries],
+        0.36,
+        label="95th percentile",
+    )
+    axes[1, 0].set(
+        xticks=range(3),
+        xticklabels=["cam1+2 -> cam0", "cam0+2 -> cam1", "cam0+1 -> cam2"],
+        ylabel="Held-out camera error [px]",
+        title="Triangulate in two views; test in the unused view",
+    )
+    axes[1, 0].legend()
+    limbs = data["bone_lengths_m"][:, :, 4:]
+    means = np.nanmedian(limbs, axis=1)
+    deviation = np.abs(limbs - means[:, None])
+    for player, color in enumerate(COLORS):
+        values = np.sort(deviation[player][np.isfinite(deviation[player])])
+        axes[1, 1].plot(
+            values * 100,
+            np.arange(1, len(values) + 1) / len(values),
+            label=f"P{player}",
+            color=color,
+        )
+    axes[1, 1].set(
+        xlim=(0, 50),
+        ylim=(0, 1),
+        xlabel="Absolute deviation from own median limb length [cm]",
+        ylabel="Fraction",
+        title="Bone-length stability (not ground-truth pose error)",
+    )
+    axes[1, 1].legend()
+    for ax in axes.flat:
+        ax.grid(alpha=0.2)
+    fig.suptitle(
+        "Meiji clip_000 | No independent 3D ground truth is available", fontsize=16
+    )
+    fig.savefig(output / "diagnostics.png", dpi=140)
+    plt.close(fig)
+
+
+def crop_sheet(
+    frames: list[np.ndarray],
+    data: dict[str, np.ndarray],
+    t: int,
+    threshold: float,
+    output: Path,
+) -> None:
+    sheet = np.full((910, 1440, 3), (43, 26, 16), np.uint8)
+    cv_text(
+        sheet,
+        f"Frame {t} | white: input 2D | colored: 3D reprojection | magenta: residual",
+        (25, 36),
+        0.8,
+    )
+    for person in range(2):
+        for camera in range(3):
+            obs = data["observations_px"][person, t, :, camera]
+            pred = data["reprojected_px"][person, t, :, camera]
+            score = data["scores"][person, t, :, camera]
+            good = obs[np.isfinite(obs).all(-1) & (score >= threshold)]
+            margin = max(15, np.ptp(good[:, 1]) * 0.25)
+            lo = np.floor(good.min(0) - margin).astype(int)
+            hi = np.ceil(good.max(0) + margin).astype(int)
+            lo = np.maximum(lo, 0)
+            hi = np.minimum(hi, [1920, 1080])
+            crop = frames[camera][lo[1] : hi[1], lo[0] : hi[0]]
+            scale = min(440 / crop.shape[1], 370 / crop.shape[0])
+            crop = cv2.resize(
+                crop, None, fx=scale, fy=scale, interpolation=cv2.INTER_CUBIC
+            )
+            crop = overlay(
+                crop,
+                (obs - lo) * scale,
+                (pred - lo) * scale,
+                score,
+                BGR[person],
+                threshold,
+            )
+            x = camera * 480 + (480 - crop.shape[1]) // 2
+            y = 95 + person * 405
+            sheet[y : y + crop.shape[0], x : x + crop.shape[1]] = crop
+            cv_text(
+                sheet,
+                f"cam{camera} / P{person}  ({scale:.1f}x)",
+                (camera * 480 + 25, y - 15),
+                0.7,
+                BGR[person],
+            )
+    cv2.imwrite(str(output / f"crops_frame_{t:04d}.png"), sheet)
+
+
+def write_viewer(data: dict[str, np.ndarray], metrics: dict, output: Path) -> None:
+    def serial(a: np.ndarray) -> object:
+        b = np.round(a, 4).astype(object)
+        b[~np.isfinite(a)] = None
+        return b.tolist()
+
+    content = {
+        "points": serial(data["X_init"]),
+        "pairs": serial(data["pair_points"]),
+        "edges": EDGES.tolist(),
+        "court": CourtLines().lines,
+        "centers": data["camera_centers"].tolist(),
+        "fps": metrics["fps"],
+        "frames": metrics["frames"],
+    }
+    template = Path(__file__).with_name("viewer.html").read_text()
+    html = template.replace(
+        "__DATA__", json.dumps(content, separators=(",", ":"), allow_nan=False)
+    )
+    (output / "index.html").write_text(html)
+    node = (
+        Path(__file__).resolve().parents[3]
+        / "knowledge/nodes/run-meiji-clip000-triangulation.md"
+    )
+    body = node.read_text().split("---", 2)[2].lstrip()
+    (output / "report.md").write_text(
+        "# Meiji clip_000 初期3Dポーズの検証\n\n"
+        "このレポートはknowledge node本文から生成した閲覧用コピーです。\n\n" + body
+    )
+
+
+def render(clip: Path, output: Path, stride: int) -> None:
+    metrics = json.loads((output / "metrics.json").read_text())
+    with np.load(output / "triangulation.npz") as archive:
+        data = {name: archive[name] for name in archive.files}
+    diagnostic_plot(data, metrics, output)
+    write_viewer(data, metrics, output)
+    threshold = metrics["min_score"]
+    captures = [cv2.VideoCapture(str(clip / "media" / f"cam{c}.mp4")) for c in range(3)]
+    figure = PoseFigure(data["camera_centers"])
+    err = np.linalg.norm(data["reprojection_residual_px"], axis=-1)
+    err = np.where(data["used_views"] & data["valid"][..., None], err, np.nan)
+    frame_mean = np.nanmean(err, axis=(0, 2, 3))
+    median_t = int(np.argmin(np.abs(frame_mean - np.median(frame_mean))))
+    high_t = int(np.argmin(np.abs(frame_mean - np.quantile(frame_mean, 0.95))))
+    worst_bone = np.unravel_index(
+        np.nanargmax(data["bone_lengths_m"]), data["bone_lengths_m"].shape
+    )
+    worst_bone_t = int(worst_bone[1])
+    selected = {0, 300, 700, 900, median_t, high_t, worst_bone_t}
+    overview_t = median_t - median_t % stride
+    with VideoWriter(
+        output / "triangulation.mp4", fps=metrics["fps"] / stride, crf=20
+    ) as writer:
+        for t in range(metrics["frames"]):
+            needed = t % stride == 0 or t in selected
+            frames = []
+            for camera, cap in enumerate(captures):
+                if needed:
+                    ok, frame = cap.read()
+                    if not ok:
+                        raise RuntimeError(f"Failed to decode cam{camera} frame {t}")
+                    frames.append(frame)
+                elif not cap.grab():
+                    raise RuntimeError(f"Failed to advance cam{camera} frame {t}")
+            if t in selected:
+                crop_sheet(frames, data, t, threshold, output)
+            if t % stride:
+                continue
+            canvas = np.full((1080, 1920, 3), (43, 26, 16), np.uint8)
+            cv_text(canvas, "MULTI-VIEW TRIANGULATION / X_init", (24, 38), 1.05)
+            cv_text(
+                canvas,
+                f"frame {t:04d}/1009  |  {t / metrics['fps']:.2f}s  |  3-view residual {frame_mean[t]:.2f}px",
+                (1000, 36),
+                0.75,
+            )
+            cv_text(
+                canvas,
+                "WHITE: observed 2D   TEAL: P0 reprojection   ORANGE: P1 reprojection   MAGENTA: residual",
+                (24, 76),
+                0.7,
+            )
+            for camera, frame in enumerate(frames):
+                tile = cv2.resize(frame, (640, 360), interpolation=cv2.INTER_AREA)
+                for person in range(2):
+                    tile = overlay(
+                        tile,
+                        data["observations_px"][person, t, :, camera],
+                        data["reprojected_px"][person, t, :, camera],
+                        data["scores"][person, t, :, camera],
+                        BGR[person],
+                        threshold,
+                        scale=1 / 3,
+                    )
+                cv_text(tile, f"cam{camera}", (12, 28), 0.8)
+                canvas[96:456, camera * 640 : (camera + 1) * 640] = tile
+            canvas[475:1035] = figure.render(data["X_init"], t)[..., ::-1]
+            cv_text(
+                canvas,
+                "Court-only approximate calibration, zero lens distortion | No 3D ground truth | Missing joints are not filled",
+                (24, 1062),
+                0.68,
+            )
+            longest_limb = np.nanmax(data["bone_lengths_m"][:, t, 4:])
+            if longest_limb > 1:
+                cv_text(
+                    canvas,
+                    f"OUTLIER: limb length {longest_limb:.2f}m",
+                    (1100, 465),
+                    0.72,
+                    (110, 110, 255),
+                )
+            writer.write_frame(
+                np.asarray(cv2.cvtColor(canvas, cv2.COLOR_BGR2RGB), dtype=np.uint8)
+            )
+            if t == overview_t:
+                cv2.imwrite(str(output / "overview.png"), canvas)
+            if t == worst_bone_t:
+                cv2.imwrite(str(output / "outlier.png"), canvas)
+            if t % 100 == 0:
+                print(f"Rendered {t}/{metrics['frames']} frames", flush=True)
+    for cap in captures:
+        cap.release()
+    plt.close(figure.fig)
+    print(
+        json.dumps(
+            {
+                "median_error_frame": median_t,
+                "p95_error_frame": high_t,
+                "overview_frame": overview_t,
+                "video_stride": stride,
+                "video_frames": len(range(0, metrics["frames"], stride)),
+            }
+        ),
+        flush=True,
+    )
+    (output / "render_metadata.json").write_text(
+        json.dumps(
+            {
+                "median_error_frame": median_t,
+                "p95_error_frame": high_t,
+                "overview_frame": overview_t,
+                "video_stride": stride,
+            },
+            indent=2,
+        )
+    )
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--clip", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--stride", type=int, default=2)
+    args = parser.parse_args()
+    if args.stride < 1:
+        raise ValueError("stride must be positive")
+    render(args.clip, args.output, args.stride)
+
+
+if __name__ == "__main__":
+    main()
