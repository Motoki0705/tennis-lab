{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Motoki0705/tennis-lab/knowledge/literature/schema/status.schema.json",
  "title": "tennis-lab literature radar daily status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "initialized_at",
    "last_curated_at",
    "generated_at",
    "quota_mode",
    "quota_note",
    "ingestion"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "date": { "type": "string", "format": "date" },
    "initialized_at": { "type": ["string", "null"], "format": "date-time" },
    "last_curated_at": { "type": ["string", "null"], "format": "date-time" },
    "generated_at": { "type": ["string", "null"], "format": "date-time" },
    "quota_mode": {
      "enum": ["enforced", "historical_backfill"]
    },
    "quota_note": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "ingestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_candidates",
        "daily_limit",
        "open_candidates",
        "open_limit",
        "collectors",
        "topics"
      ],
      "properties": {
        "accepted_candidates": { "type": "integer", "minimum": 0 },
        "daily_limit": { "type": "integer", "minimum": 0 },
        "open_candidates": { "type": "integer", "minimum": 0 },
        "open_limit": { "type": "integer", "minimum": 0 },
        "collectors": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/quota" }
        },
        "topics": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/quota" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "quota_mode": { "const": "historical_backfill" }
        }
      },
      "then": {
        "properties": {
          "quota_note": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "$defs": {
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "limit", "remaining"],
      "properties": {
        "accepted": { "type": "integer", "minimum": 0 },
        "limit": { "type": "integer", "minimum": 0 },
        "remaining": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
