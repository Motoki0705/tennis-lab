{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Motoki0705/tennis-lab/knowledge/literature/schema/candidate.schema.json",
  "title": "tennis-lab literature radar candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "collector_id",
    "schedule_run_id",
    "discovered_at",
    "paper",
    "screening",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "literature_candidate" },
    "collector_id": {
      "enum": ["perception", "geometry", "systems"]
    },
    "schedule_run_id": {
      "type": "string",
      "minLength": 1
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "year", "identifiers", "urls"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "venue": {
          "type": ["string", "null"]
        },
        "identifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doi", "arxiv", "openreview"],
          "properties": {
            "doi": { "type": ["string", "null"] },
            "arxiv": { "type": ["string", "null"] },
            "openreview": { "type": ["string", "null"] }
          }
        },
        "urls": {
          "type": "object",
          "required": ["primary"],
          "additionalProperties": {
            "type": ["string", "null"],
            "format": "uri"
          },
          "properties": {
            "primary": { "type": "string", "format": "uri" },
            "paper": { "type": ["string", "null"], "format": "uri" },
            "code": { "type": ["string", "null"], "format": "uri" },
            "project": { "type": ["string", "null"], "format": "uri" },
            "dataset": { "type": ["string", "null"], "format": "uri" }
          }
        }
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "topic",
        "repo_paths",
        "relevance_score",
        "score_breakdown",
        "novelty_score",
        "evidence_level",
        "summary_ja",
        "applicability_ja",
        "risks_ja",
        "candidate_experiment_ja"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ball_detection",
              "court_detection",
              "plcs",
              "blcs",
              "tennis_scene",
              "synthetic_data_generation",
              "multi_object_tracking",
              "human_pose",
              "scene_alignment",
              "cross_cutting"
            ]
          }
        },
        "topic": {
          "enum": [
            "ball_detection",
            "court_detection",
            "multi_object_tracking",
            "human_pose_2d",
            "player_3d",
            "ball_3d",
            "scene_alignment",
            "scene_geometry",
            "avatar_rendering",
            "synthetic_data",
            "self_supervised_learning",
            "systems_optimization"
          ]
        },
        "repo_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "relevance_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "score_breakdown": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "task_fit",
            "repo_fit",
            "evidence_quality",
            "experiment_quality",
            "adoption_feasibility"
          ],
          "properties": {
            "task_fit": { "type": "integer", "minimum": 0, "maximum": 30 },
            "repo_fit": { "type": "integer", "minimum": 0, "maximum": 25 },
            "evidence_quality": { "type": "integer", "minimum": 0, "maximum": 20 },
            "experiment_quality": { "type": "integer", "minimum": 0, "maximum": 15 },
            "adoption_feasibility": { "type": "integer", "minimum": 0, "maximum": 10 }
          }
        },
        "novelty_score": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "evidence_level": {
          "enum": ["fulltext", "fulltext-code", "fulltext-code-data"]
        },
        "summary_ja": { "type": "string", "minLength": 1 },
        "applicability_ja": { "type": "string", "minLength": 1 },
        "risks_ja": { "type": "string", "minLength": 1 },
        "candidate_experiment_ja": { "type": "string", "minLength": 1 }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "url", "checked_at"],
        "properties": {
          "kind": {
            "enum": ["paper", "project", "code", "dataset", "publisher", "other"]
          },
          "url": { "type": "string", "format": "uri" },
          "checked_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
