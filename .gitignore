# Knowledge-graph run bundles are git-tracked (issue #533): repro bundle +
# test-split predictions replace checkpoints as the unit of record. Re-include
# them despite the generic runs/ and *.json/*.npz ignores above.
!knowledge/runs/
!knowledge/runs/**

# Literature Radar uses JSON as its reviewed interface and canonical record
# format. These files must remain git-tracked despite the generic *.json rule.
!knowledge/literature/**/*.json

paper/reference/

# Persist loop decisions in Markdown while keeping heavyweight validation output
# local and immutable at the paths recorded by STATE.md.
.codex-loop/**/artifacts/
.codex-loop/**/logs/
