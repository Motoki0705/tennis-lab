[Unit]
Description=tennis-lab: resolve cross-review follow-up issues (close, or implement and open a PR)
Documentation=file://%h/projects/tennis-lab/.agents/ops/followup/README.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/tennis-lab
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# resolve_followups.py takes an flock on its state dir and exits 75 when another run
# (timer or manual) holds it.
ExecStart=%h/projects/tennis-lab/.venv/bin/python %h/projects/tennis-lab/.agents/ops/followup/resolve_followups.py --repo %h/projects/tennis-lab
SuccessExitStatus=75
# No per-run issue limit: each issue may take up to --agent-timeout (3h). Stay well
# under the 2-day period so a stuck run is stopped before the next one is due.
TimeoutStartSec=36h
