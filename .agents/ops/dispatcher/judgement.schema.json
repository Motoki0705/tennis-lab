{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_sha256", "decisions"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decisions": {"type": "array", "items": {"$ref": "#/definitions/decision"}}
  },
  "definitions": {
    "text": {"type": "string", "pattern": "\\S"},
    "texts": {
      "type": "array",
      "items": {"$ref": "#/definitions/text"},
      "uniqueItems": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "scope", "behavior", "acceptance"],
      "properties": {
        "purpose": {"$ref": "#/definitions/text"},
        "scope": {"$ref": "#/definitions/text"},
        "behavior": {"$ref": "#/definitions/text"},
        "acceptance": {"$ref": "#/definitions/text"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue", "disposition", "target_parent", "priority", "requirements",
        "rationale", "facts", "missing_information", "resume_condition",
        "next_action", "sources", "dependencies"
      ],
      "properties": {
        "issue": {"type": "integer", "minimum": 1},
        "disposition": {
          "type": "string",
          "enum": [
            "startable", "information_needed", "dependency_wait", "existing_owner",
            "existing_parent", "out_of_scope", "human_hold"
          ]
        },
        "target_parent": {"type": ["integer", "null"], "minimum": 1},
        "priority": {"type": ["integer", "null"], "minimum": 1},
        "requirements": {"anyOf": [{"$ref": "#/definitions/requirements"}, {"type": "null"}]},
        "rationale": {"$ref": "#/definitions/text"},
        "facts": {
          "type": "array", "minItems": 1,
          "allOf": [{"$ref": "#/definitions/texts"}]
        },
        "missing_information": {"$ref": "#/definitions/texts"},
        "resume_condition": {"$ref": "#/definitions/text"},
        "next_action": {"$ref": "#/definitions/text"},
        "sources": {
          "type": "array", "minItems": 1,
          "allOf": [{"$ref": "#/definitions/texts"}]
        },
        "dependencies": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"disposition": {"const": "startable"}}},
          "then": {
            "properties": {
              "priority": {"type": "integer", "minimum": 1},
              "requirements": {"$ref": "#/definitions/requirements"},
              "missing_information": {"type": "array", "maxItems": 0},
              "sources": {"type": "array", "contains": {"type": "string", "pattern": "^code:"}}
            }
          },
          "else": {
            "properties": {"priority": {"type": "null"}, "requirements": {"type": "null"}}
          }
        },
        {
          "if": {"properties": {"disposition": {"const": "information_needed"}}},
          "then": {"properties": {"missing_information": {"type": "array", "minItems": 1}}}
        }
      ]
    }
  }
}
