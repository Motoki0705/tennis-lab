diff --git a/codex-rs/tui/src/app/tests/terminal_session_clear_tests.rs b/codex-rs/tui/src/app/tests/terminal_session_clear_tests.rs
new file mode 100644
index 0000000000..d2318ee493
--- /dev/null
+++ b/codex-rs/tui/src/app/tests/terminal_session_clear_tests.rs
@@ -0,0 +1,151 @@
+//! Exercise the callback at the real TUI reset boundary, without a model request.
+
+use super::*;
+use std::os::unix::fs::PermissionsExt;
+
+use codex_app_server_protocol::ContextCompactedNotification;
+use pretty_assertions::assert_eq;
+
+#[tokio::test]
+async fn explicit_clear_notifies_before_next_input_but_new_and_compact_do_not() -> Result<()> {
+    for clear in [false, true] {
+        let (mut app, _events, _ops) = make_test_app_with_channels().await;
+        let home = tempdir()?;
+        app.config.codex_home = home.path().to_path_buf().abs();
+        app.config.sqlite = SqliteConfig::new_for_testing(home.path().abs());
+        let command = home.path().join("terminal-callback");
+        let payload_path = home.path().join("terminal-callback.payload");
+        std::fs::write(&command, "#!/bin/sh\ncat > \"$0.payload\"\n")?;
+        std::fs::set_permissions(&command, std::fs::Permissions::from_mode(0o700))?;
+        app.terminal_session_clear.command = Some(command);
+        let (mut server, requests, proxy) = start_recording_app_server_with_history(
+            &app.config,
+            HistoryCapabilities::Current,
+            /*blocked_thread_list*/ None,
+            /*failed_thread_name*/ None,
+            crate::app_server_session::ThreadParamsMode::Embedded,
+            LoaderOverrides::default(),
+        )
+        .await?;
+        let mut tui = crate::tui::test_support::make_test_tui()?;
+        let event = if clear {
+            AppEvent::ClearUi { name: None }
+        } else {
+            AppEvent::NewSession { name: None }
+        };
+        app.handle_event(&mut tui, &mut server, event).await?;
+        let thread_id = app.primary_session_configured.as_ref().unwrap().thread_id;
+        assert_eq!(
+            recorded_params(&requests, "turn/start"),
+            Vec::<serde_json::Value>::new()
+        );
+        if clear {
+            assert_eq!(
+                serde_json::from_slice::<serde_json::Value>(&std::fs::read(&payload_path)?)?,
+                serde_json::json!({"version": 1, "event": "clear", "session_id": thread_id.to_string()}),
+            );
+            std::fs::remove_file(&payload_path)?;
+        } else {
+            assert!(!payload_path.exists());
+        }
+        // Manual compaction travels through the composer, while an automatic compaction
+        // arrives as a server notification. Neither represents a new conversation.
+        app.chat_widget.insert_str("/compact");
+        app.chat_widget
+            .handle_key_event(crossterm::event::KeyEvent::new(
+                crossterm::event::KeyCode::Enter,
+                crossterm::event::KeyModifiers::NONE,
+            ));
+        app.chat_widget.handle_server_notification(
+            ServerNotification::ContextCompacted(ContextCompactedNotification {
+                thread_id: thread_id.to_string(),
+                turn_id: "compacted-turn".to_string(),
+            }),
+            /*replay_kind*/ None,
+        );
+        assert!(!payload_path.exists());
+        server.shutdown().await?;
+        proxy.await??;
+    }
+    Ok(())
+}
+
+#[tokio::test]
+async fn failed_clear_keeps_existing_session_and_does_not_notify() -> Result<()> {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let home = tempdir()?;
+    app.config.codex_home = home.path().to_path_buf().abs();
+    app.config.sqlite = SqliteConfig::new_for_testing(home.path().abs());
+    let current = ThreadId::new();
+    app.enqueue_primary_thread_session(
+        test_thread_session(current, app.config.cwd.to_path_buf()),
+        Vec::new(),
+    )
+    .await?;
+    while events.try_recv().is_ok() {}
+    // If the callback runs it fails visibly. A failed server reset must not invoke it.
+    app.terminal_session_clear.command = Some(home.path().join("missing-callback"));
+    let (mut server, _requests, proxy) = start_recording_app_server_with_history(
+        &app.config,
+        HistoryCapabilities::ThreadStartFails,
+        /*blocked_thread_list*/ None,
+        /*failed_thread_name*/ None,
+        crate::app_server_session::ThreadParamsMode::Embedded,
+        LoaderOverrides::default(),
+    )
+    .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.handle_event(&mut tui, &mut server, AppEvent::ClearUi { name: None })
+        .await?;
+    assert_eq!(app.chat_widget.thread_id(), Some(current));
+    let errors = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::InsertHistoryCell(cell) => {
+                Some(lines_to_single_string(&cell.display_lines(/*width*/ 1000)))
+            }
+            _ => None,
+        })
+        .collect::<Vec<_>>()
+        .join("\n");
+    assert!(!errors.contains("Terminal session display reset failed"));
+    assert!(errors.contains("Failed to start a fresh session"));
+    server.shutdown().await?;
+    proxy.await??;
+    Ok(())
+}
+
+#[tokio::test]
+async fn callback_failure_is_visible_without_undoing_clear() -> Result<()> {
+    let (mut app, mut events, _ops) = make_test_app_with_channels().await;
+    let home = tempdir()?;
+    app.config.codex_home = home.path().to_path_buf().abs();
+    app.config.sqlite = SqliteConfig::new_for_testing(home.path().abs());
+    app.terminal_session_clear.command = Some(home.path().join("missing-callback"));
+    let (mut server, _requests, proxy) = start_recording_app_server_with_history(
+        &app.config,
+        HistoryCapabilities::Current,
+        /*blocked_thread_list*/ None,
+        /*failed_thread_name*/ None,
+        crate::app_server_session::ThreadParamsMode::Embedded,
+        LoaderOverrides::default(),
+    )
+    .await?;
+    let mut tui = crate::tui::test_support::make_test_tui()?;
+    app.handle_event(&mut tui, &mut server, AppEvent::ClearUi { name: None })
+        .await?;
+    assert!(app.primary_session_configured.is_some());
+    let errors = std::iter::from_fn(|| events.try_recv().ok())
+        .filter_map(|event| match event {
+            AppEvent::InsertHistoryCell(cell) => {
+                Some(lines_to_single_string(&cell.display_lines(/*width*/ 1000)))
+            }
+            _ => None,
+        })
+        .filter(|text| text.contains("Terminal session display reset failed"))
+        .collect::<Vec<_>>()
+        .join("\n");
+    insta::assert_snapshot!(errors, @"■ Terminal session display reset failed: could not start the terminal session clear callback");
+    server.shutdown().await?;
+    proxy.await??;
+    Ok(())
+}
