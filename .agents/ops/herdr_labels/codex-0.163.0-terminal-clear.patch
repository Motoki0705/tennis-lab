diff --git a/codex-rs/tui/src/terminal_session_clear.rs b/codex-rs/tui/src/terminal_session_clear.rs
new file mode 100644
index 0000000000..5748f8586e
--- /dev/null
+++ b/codex-rs/tui/src/terminal_session_clear.rs
@@ -0,0 +1,169 @@
+//! Opt-in, local terminal notification after a successful explicit conversation reset.
+//!
+//! The app server may be shared and has neither the client's terminal environment nor its
+//! process ancestry. Run this callback in the TUI, before processing the next input. It is
+//! independent of model-facing hooks and is never called by context compaction.
+
+use std::path::PathBuf;
+use std::process::Stdio;
+use std::time::Duration;
+
+use anyhow::Context;
+use anyhow::anyhow;
+use anyhow::bail;
+use codex_protocol::ThreadId;
+use tokio::io::AsyncWriteExt;
+use tokio::process::Command;
+
+const COMMAND_ENV: &str = "CODEX_TUI_SESSION_CLEAR_COMMAND";
+const CALLBACK_TIMEOUT: Duration = Duration::from_secs(10);
+
+#[derive(Default)]
+pub(crate) struct TerminalSessionClear {
+    pub(crate) command: Option<PathBuf>,
+}
+
+impl TerminalSessionClear {
+    pub(crate) fn from_env() -> Self {
+        Self {
+            command: std::env::var_os(COMMAND_ENV).map(PathBuf::from),
+        }
+    }
+
+    pub(crate) async fn notify(&self, thread_id: ThreadId) -> anyhow::Result<()> {
+        self.notify_with_timeout(thread_id, CALLBACK_TIMEOUT).await
+    }
+
+    async fn notify_with_timeout(
+        &self,
+        thread_id: ThreadId,
+        timeout: Duration,
+    ) -> anyhow::Result<()> {
+        let Some(command) = &self.command else {
+            return Ok(());
+        };
+        // This is an executable selected by the launching shell, never a repository command
+        // or shell expression. Do not resolve relative paths against a workspace.
+        if !command.is_absolute() {
+            bail!("{COMMAND_ENV} must be an absolute executable path");
+        }
+        let payload = serde_json::to_vec(&serde_json::json!({
+            "version": 1,
+            "event": "clear",
+            "session_id": thread_id.to_string(),
+        }))?;
+        let mut process = Command::new(command);
+        #[cfg(unix)]
+        process.process_group(/*pgroup*/ 0);
+        let mut child = process
+            .stdin(Stdio::piped())
+            .stdout(Stdio::null())
+            .stderr(Stdio::null())
+            .kill_on_drop(/*kill_on_drop*/ true)
+            .spawn()
+            .context("could not start the terminal session clear callback")?;
+        let outcome = tokio::time::timeout(timeout, async {
+            let mut stdin = child
+                .stdin
+                .take()
+                .context("callback stdin is unavailable")?;
+            stdin.write_all(&payload).await?;
+            drop(stdin);
+            child
+                .wait()
+                .await
+                .context("could not wait for the callback")
+        })
+        .await
+        .unwrap_or_else(|_| Err(anyhow!("terminal session clear callback timed out")));
+        match outcome {
+            Ok(status) if status.success() => Ok(()),
+            Ok(status) => bail!("terminal session clear callback exited with {status}"),
+            Err(err) => {
+                #[cfg(unix)]
+                if let Some(pid) = child.id() {
+                    // SAFETY: process_group(0) placed this owned, unreaped child in its
+                    // own group. Stop its helpers before accepting another user input.
+                    unsafe { libc::killpg(pid as libc::pid_t, libc::SIGKILL) };
+                }
+                let _ = child.start_kill();
+                child.wait().await.context("could not reap the callback")?;
+                Err(err)
+            }
+        }
+    }
+}
+
+#[cfg(all(test, unix))]
+mod tests {
+    use super::*;
+    use std::os::unix::fs::PermissionsExt;
+
+    use pretty_assertions::assert_eq;
+
+    #[tokio::test]
+    async fn callback_receives_new_session_before_notify_returns() -> anyhow::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let command = dir.path().join("callback with spaces");
+        std::fs::write(&command, "#!/bin/sh\ncat > \"$0.payload\"\n")?;
+        std::fs::set_permissions(&command, std::fs::Permissions::from_mode(0o700))?;
+        let callback = TerminalSessionClear {
+            command: Some(command.clone()),
+        };
+        let thread_id = ThreadId::new();
+        callback.notify(thread_id).await?;
+        assert_eq!(
+            serde_json::from_slice::<serde_json::Value>(&std::fs::read(
+                command.with_file_name("callback with spaces.payload")
+            )?)?,
+            serde_json::json!({"version": 1, "event": "clear", "session_id": thread_id.to_string()}),
+        );
+        Ok(())
+    }
+
+    #[tokio::test]
+    async fn disabled_callback_is_a_noop_and_relative_commands_are_rejected() {
+        let thread_id = ThreadId::new();
+        TerminalSessionClear::default()
+            .notify(thread_id)
+            .await
+            .unwrap();
+        let callback = TerminalSessionClear {
+            command: Some(PathBuf::from("./callback")),
+        };
+        assert_eq!(
+            callback.notify(thread_id).await.unwrap_err().to_string(),
+            "CODEX_TUI_SESSION_CLEAR_COMMAND must be an absolute executable path",
+        );
+    }
+
+    #[tokio::test]
+    async fn callback_failures_and_timeouts_are_reported() -> anyhow::Result<()> {
+        let dir = tempfile::tempdir()?;
+        let command = dir.path().join("callback");
+        let callback = TerminalSessionClear {
+            command: Some(command.clone()),
+        };
+        assert!(callback.notify(ThreadId::new()).await.is_err());
+        std::fs::write(&command, "#!/bin/sh\ncat >/dev/null\nexit 7\n")?;
+        std::fs::set_permissions(&command, std::fs::Permissions::from_mode(0o700))?;
+        assert!(
+            callback
+                .notify(ThreadId::new())
+                .await
+                .unwrap_err()
+                .to_string()
+                .contains("exit status: 7")
+        );
+        std::fs::write(&command, "#!/bin/sh\nexec sleep 30\n")?;
+        assert_eq!(
+            callback
+                .notify_with_timeout(ThreadId::new(), Duration::from_millis(50))
+                .await
+                .unwrap_err()
+                .to_string(),
+            "terminal session clear callback timed out",
+        );
+        Ok(())
+    }
+}
