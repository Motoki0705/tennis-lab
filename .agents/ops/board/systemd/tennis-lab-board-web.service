[Unit]
Description=tennis-lab parent board (read-only loopback web UI)
Documentation=file://%h/projects/tennis-lab/.agents/ops/board/README.md

[Service]
Type=simple
WorkingDirectory=%h/projects/tennis-lab
Environment=PYTHONPATH=%h/projects/tennis-lab/.agents/ops
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/tennis-lab/.venv/bin/python -m board web --port 8790
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
